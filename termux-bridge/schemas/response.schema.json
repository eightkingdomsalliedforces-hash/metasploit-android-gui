{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operationId", "action", "success",
    "exitCode", "message", "progress", "data"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "action": {
      "enum": [
        "INSTALL_METASPLOIT", "REPAIR_METASPLOIT", "INITIALIZE_DATABASE",
        "START_SERVICES", "STOP_SERVICES", "START_RPC", "STOP_RPC",
        "UPDATE_METASPLOIT", "BACKUP_ENVIRONMENT", "RESTORE_ENVIRONMENT",
        "HEALTH_CHECK", "CLEAN_CACHE"
      ]
    },
    "success": { "type": "boolean" },
    "exitCode": { "type": "integer" },
    "message": { "type": "string", "maxLength": 4096 },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "data": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    }
  }
}
